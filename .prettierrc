{
    "semi": false,
    "singleQuote": false,
    "singleAttributePerLine": false,
    "htmlWhitespaceSensitivity": "css",
    "printWidth": 100,
    "plugins": ["prettier-plugin-organize-imports"],
    "tabWidth": 4,
    "trailingComma": "es5",
    "overrides": [
        {
            "files": "**/*.yml",
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
